# Local data drop-in workspace: keep the folder structure (.gitkeep) and the
# README under version control, but ignore any audio/data the user drops in.
/data/**
!/data/
!/data/**/
!/data/README.md
!/data/**/.gitkeep

# Manual-review tables (per-site Kaleidoscope exports). These are field data,
# not code, and stay local -- scripts/summarize_review.py reads them from here.
/reviews/

# Human labels are the one thing in data/ that is not reproducible: they are
# listening hours. Version them.
!/data/labels/
!/data/labels/*.csv

# The time gate's lookup table: filename, timestamp, offset, and nothing else.
# Versioned because without it a run on a machine that has no copy of
# cleanup_vs_review.csv writes a CSV silently missing every gated_ column, and
# three Colab folds were trained that way on 2026-08-24 before the headers were
# read. cleanup_vs_review.csv itself stays ignored above and must: 2,882 of its
# cells carry the recorder's position. scripts/make_review_gate_table.py builds
# this one and refuses to write a coordinate or a duplicated key.
!/data/outputs/auto_cleanup/
!/data/outputs/auto_cleanup/review_gate_table.csv

# Third-party publisher material. The MethodsX author guide, the article
# template and the example articles are Elsevier's, not ours; they were
# tracked here until 2026-08-26 and are 6.3 MB of a 20 MB repository that
# points at itself from a Data availability statement. Keep a local copy if
# useful, but it does not ship.
/paper/methodsx_reference/

# Manuscript copies that are not the source. The .tex in overleaf/ is the
# manuscript; a .docx export goes stale the moment the .tex moves, and one
# sat fifteen days behind it while looking authoritative.
/paper/*.docx
